# =============================================================================
#  GitHub Issues → Swarmica — файл настроек по умолчанию
#
#  Скопируйте этот файл в .env рядом с docker-compose.yml и заполните значения:
#      cp .env.example .env
#  Обязательные переменные отмечены [обязательно]. Остальные можно не трогать —
#  закомментированные строки (с # в начале) используют значение по умолчанию.
#  Значения пишутся без кавычек и без пробелов вокруг "=".
# =============================================================================


# -----------------------------------------------------------------------------
#  GitHub
# -----------------------------------------------------------------------------

# [обязательно] Владелец репозиториев на GitHub: организация или пользователь.
# Бот отслеживает issues и комментарии во всех его репозиториях.
# Пример: GITHUB_NAME=testit-tms
GITHUB_NAME=testit-tms

# Personal Access Token GitHub. Настоятельно рекомендуется:
# без токена лимит 60 запросов в час (хватает на 1–2 опроса), с токеном — 5000.
# Для приватных репозиториев нужен scope "repo".
# Пример: GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_TOKEN=


# -----------------------------------------------------------------------------
#  Swarmica
# -----------------------------------------------------------------------------

# [обязательно] URL инсталляции Swarmica, без "/" в конце.
# Пример: SWARMICA_API_URL=https://help.testit.software
SWARMICA_API_URL=https://help.testit.software

# [обязательно] Постоянный API-токен Swarmica: Настройки → API и интеграции.
# Пример: SWARMICA_API_TOKEN=0123456789abcdef0123456789abcdef01234567
SWARMICA_API_TOKEN=

# Email робота-заявителя, если инстанс Swarmica требует указать получателя.
# Письма на него не отправляются. По умолчанию не задан.
# Пример: SWARMICA_REQUESTER_EMAIL=github-issues@testit.software
# SWARMICA_REQUESTER_EMAIL=

# Email сотрудника Swarmica, который назначается ответственным при создании заявки.
# Если не задан — ответственного выбирает Swarmica.
# Пример: SWARMICA_ASSIGNEE_EMAIL=support@testit.software
# SWARMICA_ASSIGNEE_EMAIL=

# Шаблон ссылки на заявку в интерфейсе Swarmica; {id} заменяется на номер заявки.
# По умолчанию: {SWARMICA_API_URL}/tickets/{id}
# Пример: SWARMICA_TICKET_URL=https://help.testit.software/tickets/{id}
# SWARMICA_TICKET_URL=

# Коды статусов Swarmica. Меняйте, только если в вашей инсталляции они другие.
# OPEN    — клиент написал в issue (заявка открыта).       По умолчанию: OPEN
# PENDING — ответил сотрудник (ожидает ответа клиента).    По умолчанию: PENDING
# SOLVED  — issue закрыт (решение предоставлено).          По умолчанию: SOLVED
# SWARMICA_STATUS_OPEN=OPEN
# SWARMICA_STATUS_PENDING=PENDING
# SWARMICA_STATUS_SOLVED=SOLVED


# -----------------------------------------------------------------------------
#  Сотрудники
# -----------------------------------------------------------------------------

# Логины GitHub сотрудников через запятую, без "@" (регистр не важен).
# - Их комментарии полностью переносятся в заявку, после чего статус заявки
#   принудительно ставится PENDING (ожидает ответа клиента), а если issue
#   уже закрыт — SOLVED.
# - Issue, открытые ими, заявку в Swarmica не создают (она появится при
#   первом комментарии клиента).
# По умолчанию список пуст — все авторы считаются клиентами.
# Пример: IGNORE_COMMENT_AUTHORS=support-den,taipoxinous,PavelButuzov
IGNORE_COMMENT_AUTHORS=


# -----------------------------------------------------------------------------
#  Работа бота
# -----------------------------------------------------------------------------

# Интервал между опросами GitHub, в секундах. Минимум 60. По умолчанию: 300
# Пример: POLL_INTERVAL_SECONDS=300
# POLL_INTERVAL_SECONDS=300

# Уровень логирования: DEBUG, INFO, WARNING, ERROR. По умолчанию: INFO
# Пример: LOG_LEVEL=DEBUG
# LOG_LEVEL=INFO

# Сколько ключей уже доставленных событий хранить в state.json (защита от
# повторной отправки). Минимум 100. По умолчанию: 10000
# SENT_KEYS_MAX=10000

# Путь к файлу состояния внутри контейнера. По умолчанию: /data/state.json
# В Docker не меняйте: папка ./data монтируется именно в /data.
# STATE_PATH=/data/state.json


# -----------------------------------------------------------------------------
#  Telegram — ОТКЛЮЧЁН
#  Сейчас эти переменные не читаются. Понадобятся, только если Telegram снова
#  подключить в коде (см. bot/telegram/__init__.py).
# -----------------------------------------------------------------------------

# Токен бота от @BotFather.
# Пример: TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
# TELEGRAM_BOT_TOKEN=

# ID чата или группы для уведомлений (у групп начинается с -100).
# Пример: TELEGRAM_CHAT_ID=-1001234567890
# TELEGRAM_CHAT_ID=

# Сколько символов текста issue/комментария показывать в уведомлении. По умолчанию: 300
# BODY_PREVIEW_LENGTH=300
